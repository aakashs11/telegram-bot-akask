# Local development environment (copy to .env and fill in values)
# See docs/SECRETS.md for how to obtain credentials securely.

# Dev Telegram bot only — do not use the production bot token locally
TELEGRAM_BOT_TOKEN=

# OpenAI (agent + moderation)
OPENAI_API_KEY=

# YouTube Data API v3
YOUTUBE_API_KEY=

# Google Sheet ID (user profiles, moderation warnings)
SHEET_ID=

# Google Drive folder ID (notes / study materials root)
DRIVE_FOLDER_ID=

# Set automatically by start_devtest.sh; leave empty
NGROK_URL=
